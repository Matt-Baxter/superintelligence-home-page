{
  "name": "si-home",
  "version": "1.0.0",
  "description": "Superintelligence Homepage: a multi-source, ontology-tagged homepage for advanced AI progress (SEIS 606 Project 2).",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/modules.js gen && node scripts/codemap.js build && esbuild client/jr.jsx --bundle --minify --format=iife --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/js/jr.js",
    "start": "node --no-warnings server.js",
    "dev:sample": "node --no-warnings test/serve-fixtures.js",
    "test": "node test/e2e.js",
    "dev:sample:pg": "node --no-warnings test/serve-fixtures-pg.js",
    "preflight": "node scripts/preflight.js",
    "prepare": "node scripts/install-hooks.js",
    "kit:sync": "node scripts/agent-kit.js sync",
    "kit:check": "node scripts/agent-kit.js check",
    "kit:export": "node scripts/agent-kit.js export",
    "kit:mcp": "node agent-kit/mcp/server.js",
    "modules:check": "node scripts/modules.js check",
    "modules:list": "node scripts/modules.js list",
    "codemap": "node scripts/codemap.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "esbuild": "^0.28.2",
    "express": "4.21.2",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "22.x"
  }
}
