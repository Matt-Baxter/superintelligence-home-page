{
  "name": "si-home",
  "version": "1.0.0",
  "description": "Superintelligence Homepage: a multi-source, ontology-tagged homepage for advanced AI progress (SEIS 606 Project 2).",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/modules.js gen && node scripts/codemap.js build && node scripts/spec-index.js && esbuild client/jr.jsx --bundle --minify --format=iife --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/js/jr.js",
    "start": "node --no-warnings server.js",
    "test:demo": "node test/demo-e2e.js",
    "demo": "node --no-warnings test/serve-demo.js",
    "dev:sample": "node --no-warnings test/serve-fixtures.js",
    "test": "node test/e2e.js",
    "dev:sample:pg": "node --no-warnings test/serve-fixtures-pg.js",
    "preflight": "node scripts/preflight.js",
    "prepare": "node scripts/install-hooks.js",
    "kit:sync": "node scripts/agent-kit.js sync",
    "kit:check": "node scripts/agent-kit.js check",
    "kit:export": "node scripts/agent-kit.js export",
    "kit:mcp": "node agent-kit/mcp/server.js",
    "modules:check": "node scripts/modules.js check",
    "modules:list": "node scripts/modules.js list",
    "codemap": "node scripts/codemap.js",
    "learn:worker": "node scripts/learn-worker.js",
    "expr:check": "node scripts/expr-check.js",
    "schema": "node scripts/schema.js",
    "test:spec": "node test/spec-acceptance.js --browser",
    "lab": "node scripts/lab.js",
    "spec:status": "node scripts/spec-status.js",
    "bench": "node scripts/bench.js --record",
    "watch": "node scripts/watch.js",
    "project:sync": "node scripts/project-sync.js",
    "lab:results": "node scripts/lab-results.js",
    "dossier": "node scripts/dossier.js",
    "test:research": "node --no-warnings test/research-feed.js",
    "checkin": "node scripts/checkin.js",
    "quality": "node scripts/quality.js",
    "advise": "node scripts/advise.js",
    "judge:report": "node scripts/judge-report.js",
    "hub": "node scripts/hub.js",
    "test:cms": "node test/cms-e2e.js",
    "test:terms": "node test/terms-e2e.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "esbuild": "^0.28.2",
    "express": "4.21.2",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
