# Postgres connection string. Locally: a throwaway test database with fake data only.
# On Vercel: set automatically by the Neon integration (Storage tab). Never commit a real one.
DATABASE_URL=
# Random string Vercel Cron sends to /api/cron/fetch. Use "test-secret" locally.
CRON_SECRET=
# Optional. "fixtures" reads the saved sample feeds in tests/fixtures/ instead of the real sources.
SOURCES=
# Optional. Anthropic API key for the AI significance judge. Without it, judging is off and every
# keyword-matched story is shown. On Vercel, add it in the project's environment settings only.
ANTHROPIC_API_KEY=
# Optional. Claude model for the judge (default claude-haiku-5-5; e.g. claude-sonnet-5-5).
JUDGE_MODEL=
# Optional. "anthropic", "fixtures" (tests: fake judge, no API calls) or "off".
JUDGE=
