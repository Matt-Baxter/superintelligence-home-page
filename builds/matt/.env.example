# Postgres connection string. Locally: a throwaway test database with fake data only.
# On Vercel: set automatically by the Neon integration (Storage tab). Never commit a real one.
DATABASE_URL=
# Random string Vercel Cron sends to /api/cron/fetch. Use "test-secret" locally.
CRON_SECRET=
# Optional. "fixtures" reads the saved sample feeds in tests/fixtures/ instead of the real sources.
SOURCES=
