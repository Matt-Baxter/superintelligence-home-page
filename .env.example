# Copy to .env for local Postgres; leave DATABASE_URL unset to use SQLite in ./data.
DATABASE_URL=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/fetch. Use a long random value.
CRON_SECRET=
APP_TZ=America/Chicago

# Optional: harvesting
# Stop starting new feed fetches after this many ms in one run (default 45000, fits a 60 s Vercel function).
HARVEST_BUDGET_MS=45000

# Optional: Postgres pool (defaults suit Neon Free on Vercel: 2 connections, closed after 5 s idle so Neon can scale to zero)
# PG_POOL=2
# PG_IDLE_MS=5000
