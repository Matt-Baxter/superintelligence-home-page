# Copy to .env for local Postgres; leave DATABASE_URL unset to use SQLite in ./data.
DATABASE_URL=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/fetch. Use a long random value.
CRON_SECRET=
APP_TZ=America/Chicago

# Optional: harvesting
# Stop starting new feed fetches after this many ms in one run (default 45000, fits a 60 s Vercel function).
HARVEST_BUDGET_MS=45000

# Optional: Postgres pool (defaults suit Neon Free on Vercel: 2 connections, closed after 5 s idle so Neon can scale to zero)
# PG_POOL=2
# PG_IDLE_MS=5000

# Which version of the site runs: spec (default, exactly the shared spec) or extended (spec plus John's extras). See modules/profiles.json.
SITE_PROFILE=spec

# Judge panel (background workers only, never the web server): two different models compared with the rules judge,
# behind identity, prestige and wording masks (modules/review/panel.js). Free or local providers from lib/providers.js;
# each needs its own key variable (GROQ_API_KEY, OPENROUTER_API_KEY, ...). Leave empty and the rules judge stands alone.
PANEL_MODELS=
# PANEL_MODELS=ollama:gemma3:12b,groq:llama-3.1-8b-instant
# A bigger open model that advises when the panel's models disagree, and reviews judging quality (scripts/advise.js).
# It never sets a score. Pin an id from the provider's current list.
ADVISOR_MODEL=
# ADVISOR_MODEL=groq:openai/gpt-oss-120b

# Paper responses (proposed REQ-056..059, extended only). All optional; everything runs locally at no cost.
# PAPER_CACHE=out/papers        # where fetched papers are cached (default out/papers; a temp dir on Vercel)
# PIPER_MODEL=/path/voice.onnx  # a Piper voice for narration (else espeak-ng, else captions only)
# ESPEAK_VOICE=en-us
# ESPEAK_RATE=158
# RESPONSE_QUALITY=m            # Manim quality: l (480p), m (720p), h (1080p)
# Natural local voice (Kokoro, Apache-2.0): pip install kokoro-onnx soundfile, and put kokoro-v1.0.int8.onnx and
# voices-v1.0.bin (from github.com/thewh1teagle/kokoro-onnx releases) in ~/.cache/si-voices, or point at them:
# KOKORO_MODEL=/path/kokoro-v1.0.int8.onnx
# KOKORO_VOICES=/path/voices-v1.0.bin
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=0.86
# RESPONSE_VOICE=kokoro         # kokoro | espeak | none
# RESPONSE_FONT=Inter
